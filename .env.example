# ==============================================================================
# SWASTHYA SENSE - Environment Variables Template
# Smart Follow-up. Timely Attention. Better Care.
# ==============================================================================

# Telegram Bot Integration (Obtain token from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SwasthyaSenseBot
TELEGRAM_ENABLED=false
TELEGRAM_DRY_RUN=true

# Daily Reminder Scheduler Configuration
REMINDER_TIME=09:00
REMINDER_TIMEZONE=Asia/Kolkata
LINKING_TOKEN_EXPIRE_MINUTES=30

# Optional Groq LLM API Key (Clinical report synthesis; deterministic fallback if omitted)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Server Defaults
PORT=8000
PYTHONUNBUFFERED=1

# Google OAuth & Authentication Settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local redirect URI (for local development on Vite port 5173):
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/callback/google
# Production redirect URI (for Vercel deployment):
# GOOGLE_REDIRECT_URI=https://swasthya-sense-peach.vercel.app/api/auth/callback/google

JWT_SECRET=super_secret_jwt_key_2026_xyz987
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# MongoDB Atlas Settings
MONGODB_URI=
MONGODB_DATABASE=healthCare

# ==============================================================================
# Frontend (Vercel) Environment Variables
# Configure these in your Vercel Project Settings -> Environment Variables:
# ==============================================================================
# Base URL of your deployed backend service (e.g., https://swasthya-sense-api.onrender.com)
VITE_API_URL=
# Google Client ID (Frontend public variable, never expose client secret):
VITE_GOOGLE_CLIENT_ID=

