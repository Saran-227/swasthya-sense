# ==============================================================================
# SWASTHYA SENSE - Environment Variables Template
# Smart Follow-up. Timely Attention. Better Care.
# ==============================================================================

# Telegram Bot Integration (Obtain token from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SwasthyaSenseBot
TELEGRAM_ENABLED=false
TELEGRAM_DRY_RUN=true

# Daily Reminder Scheduler Configuration
REMINDER_TIME=09:00
REMINDER_TIMEZONE=Asia/Kolkata
LINKING_TOKEN_EXPIRE_MINUTES=30

# Optional Groq LLM API Key (Clinical report synthesis; deterministic fallback if omitted)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Server Defaults
PORT=8000
PYTHONUNBUFFERED=1

# Google OAuth & Authentication Settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/callback/google
JWT_SECRET=super_secret_jwt_key_2026_xyz987
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Settings
MONGODB_URI=
MONGODB_DATABASE=healthCare

# Frontend Vercel Deployment Settings
# (Set in Vercel project environment variables to point to your live backend API URL)
VITE_API_URL=

